{
  "name": "jovian-desk",
  "productName": "Jovian Desk",
  "version": "0.2.0",
  "description": "A transparent, interactive desktop Solar System observatory.",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "node --experimental-strip-types --test tests/physics.test.ts",
    "test:desktop": "node tests/desktop.mjs",
    "test:layout": "node tests/window-layout.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "three": "0.186.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "electron": "44.3.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "rolldown": "1.2.8"
  }
}
